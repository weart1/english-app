# Cloudflare Pages / Netlify headers. (Cloudflare Pages serves index.html for
# unknown routes automatically when there is no 404.html — no redirect rule needed.)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/workbox-*
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
